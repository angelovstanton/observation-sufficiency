# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Auth: API keys. Azure OpenAI models use AzureKeyCredential (BAR_AZURE_OPENAI_KEY);
# Claude (Anthropic via Azure AI Services) uses the x-api-key header
# (BAR_AZURE_ANTHROPIC_KEY). There is NO DefaultAzureCredential / `az login` path in the
# code — set the *_KEY vars below.
#
# The verification suite (../TESTING.md) is entirely zero-LLM: it needs NONE of these
# keys or endpoints. Credentials are only required to run new measurement sweeps, never
# to reproduce or verify the locked results.

# --- Azure OpenAI Service (GPT-4.1, GPT-4.1-nano, o4-mini) ---
BAR_AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
BAR_AZURE_OPENAI_API_VERSION=2024-12-01-preview
BAR_AZURE_OPENAI_KEY=<your-azure-openai-key>

# --- Claude Sonnet (Anthropic via Azure AI Services) ---
BAR_AZURE_ANTHROPIC_ENDPOINT=https://<your-resource>.services.ai.azure.com/anthropic/v1/messages
BAR_AZURE_ANTHROPIC_KEY=<your-anthropic-via-azure-key>

# --- Azure AI Foundry serverless (optional; unified Inference client) ---
BAR_AZURE_INFERENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/models

# --- Deployment names (STACK.md §6: robustness check, not a leaderboard) ---
BAR_MODEL_DEPLOYMENT_1=gpt-4.1
BAR_MODEL_DEPLOYMENT_2=gpt-4.1-nano
# Slot 3: Llama (Azure AI Foundry serverless); not used by Axis C or the Revision 1 batch.
# Slot 4: o4-mini — AxisCMode and the Revision 1 batch (experiments/batch) read it from slot 4.
# Slot 5: Claude — AxisCMode reads it from slot 5.
BAR_MODEL_DEPLOYMENT_3=<llama-deployment>
BAR_MODEL_DEPLOYMENT_4=o4-mini
BAR_MODEL_DEPLOYMENT_5=claude-sonnet-4-6

# --- Experiment defaults ---
BAR_TOKENIZER=o200k_base       # fixed; record on every run; bump requires explicit decision
BAR_TEMPERATURE=0              # documentation only — no code reads this var; the real
                                # per-model temperature behavior is hardcoded in
                                # LlmClient.cs and described in STACK.md §3
BAR_TESTBED_BASE_URL=http://localhost:8000
BAR_RANDOM_SEED=42
