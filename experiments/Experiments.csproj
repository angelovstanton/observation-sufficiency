<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\shared\harness\Shared.Harness.csproj" />
  </ItemGroup>

  <!-- Exclude any archived/ directory from compilation, in case one exists
       locally — the SDK's default **/*.cs glob would otherwise compile it. -->
  <ItemGroup>
    <Compile Remove="archived\**" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
